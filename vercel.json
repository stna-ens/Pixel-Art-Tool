{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/style.css", "destination": "/www/style.css" },
    { "source": "/script.js", "destination": "/www/script.js" },
    { "source": "/icon.png", "destination": "/www/icon.png" },
    { "source": "/", "destination": "/www/index.html" },
    { "source": "/(.*)", "destination": "/www/index.html" }
  ]
}
